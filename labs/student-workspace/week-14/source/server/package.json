{
  "name": "engse203-week14-server-campus-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.0"
  }
}
