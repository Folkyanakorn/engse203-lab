PORT=3000
NODE_ENV=development
# origin ของ front-end คั่นด้วย comma (ห้ามใช้ *; ใน production ต้องระบุเสมอ)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_FILE=data/campus.db
# ใช้ใน LAB เท่านั้น: ถ้า NODE_ENV=production แล้วตั้ง true เซิร์ฟเวอร์จะไม่ยอมเริ่มทำงาน
ALLOW_DEMO_RESET=true
# rate limit ต่อ IP (ค่าเริ่มต้น: 300 ครั้ง/15 นาที, เขียน 60 ครั้ง)
#RATE_LIMIT_WINDOW_MS=900000
#RATE_LIMIT_MAX=300
#RATE_LIMIT_WRITE_MAX=60
# อยู่หลัง reverse proxy 1 ชั้น ให้ตั้ง TRUST_PROXY=1
#TRUST_PROXY=1
